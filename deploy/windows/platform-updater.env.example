# Copy outside the repository, restrict the ACL, and replace placeholders.
MULTIREMI_API_URL=http://127.0.0.1:16120
MULTIREMI_TOKEN=replace-with-api-token
MULTIREMI_PLATFORM_UPDATER_TOKEN=replace-with-independent-updater-token
MULTIREMI_PLATFORM_DRIVER=local_profile
MULTIREMI_PLATFORM_UPDATE_MODE=application
MULTIREMI_PLATFORM_STATE_DIR=C:\RemiHost\platform-updater-state
MULTIREMI_PLATFORM_RELEASE_FEED_URL=https://github.com/OWNER/REPO/releases/latest/download/platform-release.json
# Only required for the explicit legacy image executor:
# MULTIREMI_LOCAL_PROFILE_REPOSITORY=C:\RemiHost\updater-source
MULTIREMI_LOCAL_PROFILE_ROOT=C:\Users\USER\.remi\profiles
MULTIREMI_LOCAL_PROFILE_NAME=stable
# MULTIREMI_PLATFORM_NODE=C:\Program Files\nodejs\node.exe
MULTIREMI_PLATFORM_ARCH=x64
MULTIREMI_PLATFORM_MIN_FREE_BYTES=5368709120
MULTIREMI_PLATFORM_DRAIN_TIMEOUT_MS=0
