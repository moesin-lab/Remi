MULTIREMI_API_URL=http://127.0.0.1:6120
MULTIREMI_TOKEN=replace-with-platform-api-token
MULTIREMI_PLATFORM_UPDATER_TOKEN=replace-with-independent-updater-token
MULTIREMI_PLATFORM_DRIVER=systemd_release
# docker_compose/local_profile default to application bundles; images is legacy.
MULTIREMI_PLATFORM_UPDATE_MODE=application
MULTIREMI_PLATFORM_STATE_DIR=/var/lib/multiremi-platform-updater
MULTIREMI_PLATFORM_BACKUP_CONFIG=/etc/multiremi/platform-backup.json
# 0 waits for existing tasks without a deadline; positive values limit the wait in ms.
MULTIREMI_PLATFORM_DRAIN_TIMEOUT_MS=0
# Readiness deadline after a switch/restart; must exceed the API migration budget
# plus schema/process startup time. Set this in the HOST updater environment.
MULTIREMI_PLATFORM_HEALTH_TIMEOUT_MS=360000
MULTIREMI_PLATFORM_ROOT=/opt/multiremi-platform
MULTIREMI_PLATFORM_RELEASE_FEED_URL=https://github.com/OWNER/REPO/releases/latest/download/platform-release.json
MULTIREMI_PLATFORM_API_SERVICE=remi-platform-api.service
MULTIREMI_PLATFORM_WEB_SERVICE=remi-platform-web.service
MULTIREMI_PLATFORM_API_HEALTH_URL=http://127.0.0.1:6120/readyz
MULTIREMI_PLATFORM_WEB_HEALTH_URL=http://127.0.0.1:3000/login
MULTIREMI_PLATFORM_POSTGRES_CONTAINER=multiremi-platform-postgres-1
MULTIREMI_PLATFORM_OPENVIKING_CONTAINER=multiremi-platform-openviking-1
# Application services switched together. Daemons, data services and the SSH
# control plane are never included. Add api-runtime for a split deployment:
# MULTIREMI_PLATFORM_CORE_SERVICES=api,web,api-runtime
#
# Extra health URLs checked after a switch, comma separated. Split API roles
# publish api-runtime on its own port, so a switch is not complete until it
# answers /readyz too. 16121 is the default REMI_API_RUNTIME_BIND_PORT in both
# compose templates; use the host's actual value if it was changed:
# MULTIREMI_PLATFORM_EXTRA_HEALTH_URLS=http://127.0.0.1:16121/readyz
#
# Split API roles also need the profiled api-runtime service to be visible to
# the updater's own Compose commands. Set this explicitly rather
# than relying on a Compose version treating an explicitly named service as
# profile-enabling. Leave it unset for the default single-process topology:
# COMPOSE_PROFILES=split
