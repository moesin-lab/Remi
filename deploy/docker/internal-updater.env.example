# Keep outside Git. These must match the API's configured credentials.
MULTIREMI_TOKEN=replace-with-api-token
MULTIREMI_PLATFORM_UPDATER_TOKEN=replace-with-independent-updater-token
# Pin the first adoption to an explicitly reviewed, manually published release.
# API-saved releaseFeedUrl overrides this default; keep both addresses identical.
MULTIREMI_PLATFORM_RELEASE_FEED_URL=https://github.com/moesin-lab/Remi/releases/download/vX.Y.Z/platform-release.json
# api-home is mounted read-only here by compose.internal-updates.yml.
# PostgreSQL uses pg_dump/pg_restore; never mount its live data directory here.
# First path must be API HOME; rehearsal reads its volume-data-0.archive.
REMI_INTERNAL_BACKUP_PATHS=/remi-data
# Checksummed dumps and volume-data-0.archive are retained in update-state:/remi-state/backups.
REMI_INTERNAL_UPDATE_STATE=/remi-state
# Zero waits for agents to finish; it never forcibly cancels their tasks.
MULTIREMI_PLATFORM_DRAIN_TIMEOUT_MS=0
MULTIREMI_PLATFORM_MIN_FREE_BYTES=5368709120
