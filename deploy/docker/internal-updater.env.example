# Keep outside Git. These must match the API's configured credentials.
MULTIREMI_TOKEN=replace-with-api-token
MULTIREMI_PLATFORM_UPDATER_TOKEN=replace-with-independent-updater-token
MULTIREMI_PLATFORM_RELEASE_FEED_URL=https://github.com/OWNER/REPO/releases/latest/download/platform-release.json
# Zero waits for agents to finish; it never forcibly cancels their tasks.
MULTIREMI_PLATFORM_DRAIN_TIMEOUT_MS=0
MULTIREMI_PLATFORM_MIN_FREE_BYTES=5368709120
