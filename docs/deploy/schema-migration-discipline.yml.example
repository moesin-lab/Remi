name: Schema migration discipline
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  expand-discipline:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_PASSWORD: postgres
        ports: ['5432:5432']
        options: >-
          --health-cmd pg_isready --health-interval 5s
          --health-timeout 5s --health-retries 12
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: 1.3.14
      - run: bun install --registry https://registry.npmjs.org --frozen-lockfile --ignore-scripts
      - name: Enforce startup DDL discipline and schema guards
        env:
          MULTIREMI_TEST_POSTGRES_URL: postgres://postgres:postgres@127.0.0.1:5432/postgres
          SCHEMA_DDL_BASE_REF: ${{ github.event.pull_request.base.sha || github.event.before }}
        run: bun run test tests/arch/startup-schema-ddl.test.ts tests/unit/multiremi/schema-levels.test.ts tests/unit/multiremi/schema-levels-postgres.test.ts
